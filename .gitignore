# Only these framework locations are public. New top-level files stay local
# until deliberately allowlisted here. Add future source/config roots explicitly.
/*
!/.gitignore
!/AGENTS.md
!/README.md
!/LICENSE
!/docs/
!/prompts/
!/playbooks/
!/templates/
!/examples/
!/brands/
!/package.json
!/.nvmrc
!/apps/
/apps/*
!/apps/dashboard/
!/apps/engine/
# Shared agent workflows only; local agent settings stay private.
!/.claude/
/.claude/*
!/.claude/workflows/

# Owner workspaces are private; distributable fixtures live in examples/.
/brands/*
!/brands/.gitkeep
/.marketing/
/private/
/backups/
/exports/
/var/
/logs/

# Credentials and local configuration
.env
.env.*
*.pem
*.key
*.p12
.codex/

# Development and runtime artifacts
node_modules/
dist/
coverage/
*.sqlite
*.sqlite-*
*.db
*.db-*
.DS_Store
